      },
      "required": ["id", "doctorUid", "appointmentDate", "timeSlot", "appointmentId", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Central administration privileges registry."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Isolated private PII and account roles for each authenticated user."
    },
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/PatientMedicalProfile" },
      "description": "Protected baseline medical records and doctor access consent."
    },
    "/doctors/{doctorId}": {
      "schema": { "$ref": "#/entities/DoctorProfile" },
      "description": "Professional doctor profiles; publicly searchable only when approvalStatus is approved."
    },
    "/clinics/{clinicId}": {
      "schema": { "$ref": "#/entities/ClinicCenter" },
      "description": "Medical clinics and centers; publicly searchable only when approvalStatus is approved."
    },
    "/clinics/{clinicId}/staff/{staffId}": {
      "schema": { "$ref": "#/entities/ClinicStaffMember" },
      "description": "Clinic-isolated staff and affiliated doctors subcollection."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Appointments between patients and approved doctors/clinics."
    },
    "/bookedSlots/{slotId}": {
      "schema": { "$ref": "#/entities/BookedSlot" },
      "description": "Zero-PII occupied time slots used for real-time 24h availability filtering."
    },
    "/ehrRecords/{recordId}": {
      "schema": { "$ref": "#/entities/EhrRecord" },
      "description": "Electronic Health Records with patient ownership and authorized doctor sharing."
    },
    "/patientMedications/{medicationId}": {
      "schema": { "$ref": "#/entities/PatientMedication" },
      "description": "Patient-managed current medications, status lifecycle, and dose reminder schedules."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ServiceReview" },
      "description": "Post-visit patient ratings and feedback."
    },
    "/complaints/{complaintId}": {
      "schema": { "$ref": "#/entities/Complaint" },
      "description": "User complaints and violation reports handled by central admin."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only immutable audit trail of critical platform events."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Private messaging threads between a patient and an approved doctor."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages belonging exclusively to a patient-doctor conversation."
    }
  }
}
