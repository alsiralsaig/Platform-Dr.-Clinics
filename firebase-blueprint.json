        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerUid",
        "name",
        "centerType",
        "licenseNumber",
        "state",
        "locality",
        "services",
        "workingHours",
        "approvalStatus",
        "ratingAvg",
        "ratingCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClinicStaffMember": {
      "title": "ClinicStaffMember",
      "description": "Staff and affiliated doctors belonging exclusively to a clinic.",
