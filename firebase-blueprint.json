        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "patientUid",
        "patientName",
        "doctorUid",
        "doctorName",
        "doctorSpecialty",
        "state",
        "locality",
        "appointmentDate",
        "timeSlot",
        "visitType",
        "feeSdg",
        "status",
        "reviewed",
        "createdAt",
        "updatedAt"
      ]
    },
    "EhrRecord": {
      "title": "EhrRecord",
      "description": "Electronic Health Record entry including consultation, diagnosis, prescription, vitals, and nutrition plan.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
