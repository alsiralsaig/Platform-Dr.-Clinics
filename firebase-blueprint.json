        "senderName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "senderRole": { "type": "string", "enum": ["patient", "doctor"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "appointmentRef": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "conversationId",
        "patientUid",
        "doctorUid",
        "senderUid",
        "senderName",
        "senderRole",
        "text",
        "createdAt"
      ]
