        "patientUid",
        "name",
        "dosage",
        "frequency",
        "scheduleTimes",
        "status",
        "reminderEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookedSlot": {
      "title": "BookedSlot",
      "description": "Zero-PII public slot availability record used to determine 24h open slots and prevent double-booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "doctorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "appointmentDate": { "type": "string", "minLength": 8, "maxLength": 20 },
        "timeSlot": { "type": "string", "minLength": 2, "maxLength": 40 },
