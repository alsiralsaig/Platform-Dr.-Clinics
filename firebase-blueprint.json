      },
      "required": ["uid", "clinicId", "fullName", "staffRole", "permissions", "status", "addedByUid", "createdAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Patient appointment booking with an approved doctor or clinic.",
