        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reporterUid", "reporterName", "reporterRole", "targetType", "subject", "description", "status", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and governance audit trail entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "actorRole": { "type": "string", "enum": ["patient", "doctor", "clinic_admin", "central_admin"] },
        "action": { "type": "string", "minLength": 2, "maxLength": 120 },
        "targetCollection": { "type": "string", "minLength": 2, "maxLength": 60 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "details": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorUid", "actorName", "actorRole", "action", "targetCollection", "targetId", "details", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Secure patient-doctor messaging thread metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "doctorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "doctorName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "doctorSpecialty": { "type": "string", "minLength": 2, "maxLength": 100 },
        "appointmentId": { "type": "string", "maxLength": 128 },
