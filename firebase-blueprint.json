{
  "entities": {
    "AdminRole": {
      "title": "AdminRole",
      "description": "Central administration role marker document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account and PII isolated per user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "whatsappNotificationsEnabled": { "type": "boolean" },
        "darkMode": { "type": "boolean" },
        "favoriteDoctorUids": { "type": "array" },
        "favoriteClinicIds": { "type": "array" },
        "role": { "type": "string", "enum": ["patient", "doctor", "clinic_admin", "central_admin"] },
        "state": { "type": "string", "maxLength": 80 },
        "locality": { "type": "string", "maxLength": 80 },
        "area": { "type": "string", "maxLength": 100 },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "suspensionReason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "accountStatus", "createdAt", "updatedAt"]
    },
    "PatientMedicalProfile": {
      "title": "PatientMedicalProfile",
      "description": "Patient baseline medical profile and explicit doctor authorization list.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "dateOfBirth": { "type": "string", "maxLength": 20 },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "bloodType": { "type": "string", "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-", "unknown"] },
        "heightCm": { "type": "number" },
        "weightKg": { "type": "number" },
        "allergies": { "type": "array" },
        "chronicConditions": { "type": "array" },
        "emergencyContact": { "type": "string", "maxLength": 160 },
        "authorizedDoctorUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "bloodType", "allergies", "chronicConditions", "authorizedDoctorUids", "createdAt", "updatedAt"]
    },
    "DoctorProfile": {
      "title": "DoctorProfile",
      "description": "Doctor professional directory record gated by central admin approval.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "specialty": { "type": "string", "minLength": 2, "maxLength": 100 },
        "qualifications": { "type": "string", "minLength": 2, "maxLength": 300 },
        "experienceYears": { "type": "number" },
        "licenseNumber": { "type": "string", "minLength": 2, "maxLength": 80 },
        "state": { "type": "string", "minLength": 2, "maxLength": 80 },
        "locality": { "type": "string", "minLength": 2, "maxLength": 80 },
        "area": { "type": "string", "maxLength": 100 },
        "workplaceName": { "type": "string", "minLength": 2, "maxLength": 160 },
        "clinicId": { "type": "string", "maxLength": 128 },
        "consultationFeeSdg": { "type": "number" },
        "services": { "type": "array" },
        "workingDays": { "type": "array" },
        "workingHours": { "type": "string", "maxLength": 120 },
        "bio": { "type": "string", "maxLength": 800 },
        "photoKey": { "type": "string", "maxLength": 60 },
        "availabilityStatus": { "type": "string", "enum": ["available", "busy"] },
        "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected", "suspended"] },
        "reviewReason": { "type": "string", "maxLength": 500 },
        "reviewedByUid": { "type": "string", "maxLength": 128 },
        "ratingAvg": { "type": "number" },
        "ratingCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "ownerUid",
        "fullName",
        "gender",
        "specialty",
        "qualifications",
        "experienceYears",
        "licenseNumber",
        "state",
        "locality",
        "workplaceName",
        "consultationFeeSdg",
        "services",
        "workingDays",
        "workingHours",
        "approvalStatus",
        "ratingAvg",
        "ratingCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClinicCenter": {
